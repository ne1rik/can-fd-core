# Auxiliary regression: APB3 stub + reference-model anchors + CTRL polarity.
SIM ?= verilator
TOPLEVEL_LANG = verilog
VERILOG_SOURCES = $(PWD)/rtl/can_fd_ctrl.sv
TOPLEVEL = can_fd_ctrl
COCOTB_TEST_MODULES = tb.test_can_fd
SIM_BUILD = $(PWD)/sim_build_aux

export PYTHONPATH := $(PWD)/tb:$(PWD):$(PYTHONPATH)

include $(shell cocotb-config --makefiles)/Makefile.sim
