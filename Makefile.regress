.PHONY: all unit tx aux loopback inject cov_tx cov_inject cov_merge xval_model xval_rtl

all: unit tx aux loopback inject cov_tx cov_inject cov_merge

unit:
	PYTHONPATH=.:tb pytest tests/ -v

tx:
	$(MAKE) -f Makefile

aux:
	$(MAKE) -f Makefile.aux

loopback:
	$(MAKE) -f Makefile.loopback

inject:
	$(MAKE) -f Makefile.inject

cov_tx:
	$(MAKE) -f Makefile.coverage

cov_inject:
	$(MAKE) -f Makefile.coverage_inject

cov_merge:
	PYTHONPATH=.:tb python3 scripts/coverage_merge.py --min 95

xval_model:
	python3 scripts/xval_ctu_extract.py
	python3 scripts/xval_ctu_model.py

xval_rtl:
	$(MAKE) -f Makefile.xval XVAL_SHARD=0 XVAL_SHARDS=4
	$(MAKE) -f Makefile.xval XVAL_SHARD=1 XVAL_SHARDS=4
	$(MAKE) -f Makefile.xval XVAL_SHARD=2 XVAL_SHARDS=4
	$(MAKE) -f Makefile.xval XVAL_SHARD=3 XVAL_SHARDS=4
