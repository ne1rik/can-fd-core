# Cross-validation: CTU reference vectors through our TX -> RX.
SIM ?= verilator
TOPLEVEL_LANG = verilog
VERILOG_SOURCES = $(PWD)/rtl/can_fd_tx.sv $(PWD)/rtl/can_fd_rx.sv $(PWD)/rtl/can_fd_loopback.sv $(PWD)/rtl/can_bit_timing.sv
TOPLEVEL = can_fd_loopback
COCOTB_TEST_MODULES = tests.test_xval_ctu
SIM_BUILD = $(PWD)/sim_build_xval

export PYTHONPATH := $(PWD)/tb:$(PWD):$(PYTHONPATH)
export XVAL_SHARD ?= 0
export XVAL_SHARDS ?= 1

include $(shell cocotb-config --makefiles)/Makefile.sim
